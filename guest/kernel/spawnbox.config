# Spawnbox additions on top of Firecracker's 6.18 guest config.

# Read the running config from /proc/config.gz.
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# Docker inside a sandbox: NAT, connection tracking, bridge filtering.
CONFIG_NF_NAT=y
CONFIG_NFT_CT=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_COMPAT=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_BRIDGE_NETFILTER=y
