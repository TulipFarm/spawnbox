---
import { Code } from "astro:components";
import Box from "../components/Box.astro";
import Logo from "../components/Logo.astro";
import Page from "../layouts/Page.astro";

const repo = "https://github.com/TulipFarm/spawnbox";
const install = "curl -fsSL https://spawnbox.tulipfarm.ai/install.sh | sh";
const demoLines = [
  "spawnbox create --timeout 600",
  "spawnbox exec $S -- python3 main.py",
  "spawnbox ports publish $S 3000",
  "spawnbox fork $S --count 3",
  "spawnbox pause $S",
];
const ptyCmd = "python3 main.py";
const codeLang = (v: string) => (/^(spawnbox|curl|npm) /.test(v) ? "bash" : /^(GET|POST|PUT|DELETE) \//.test(v) ? "http" : null);

const C = Math.cos(Math.PI / 6);
const pt = (i: number, j: number, k: number, s: number) => [(i - j) * C * s, (i + j) * 0.5 * s - k * s];
const xy = (i: number, j: number, k: number, s: number) => pt(i, j, k, s).map((n) => n.toFixed(1)).join(",");

// hero scene, in grid units
const S = 24;
const vms = [
  { i: 1, j: 1, tone: "solid", logo: "claude" },
  { i: 4, j: 1, tone: "solid", logo: "codex" },
  { i: 1, j: 4, tone: "solid", logo: "langgraph" },
  { i: 7, j: 1, tone: "solid", logo: "chrome" },
  { i: 4, j: 4, tone: "solid", logo: "next" },
  { i: 7, j: 4, tone: "wire", logo: null },
] as const;
const agent = [-1.3, -1.3, 6] as const;
const packets = vms
  .filter((v) => v.tone === "solid")
  .map((v, n) => ({
    d: `M${xy(agent[0], agent[1], agent[2], S)} L${xy(v.i + 1, v.j + 1, 2.4, S)}`,
    delay: `${(n * 0.55).toFixed(2)}s`,
  }));
const at = (i: number, j: number, k: number) => pt(i, j, k, S);

// fleet scene: 16 servers x 64 sandboxes; rows of 8 drop in, nearest servers first
const FS = 10;
const cube = (w: number) => {
  const q = (a: number, b: number, c: number) => pt(a, b, c, FS).map((n) => n.toFixed(1)).join(",");
  return {
    top: [q(0, 0, w), q(w, 0, w), q(w, w, w), q(0, w, w)].join(" "),
    left: [q(0, w, 0), q(w, w, 0), q(w, w, w), q(0, w, w)].join(" "),
    right: [q(w, 0, 0), q(w, w, 0), q(w, w, w), q(w, 0, w)].join(" "),
  };
};
const mini = cube(0.4);
const tints = ["claude", "chrome", "", "langgraph", "", "codex", "", "", "next", ""];
const main = { i: -11, j: 23 };
const fleet = Array.from({ length: 16 }, (_, n) => ({ gi: n % 4, gj: Math.floor(n / 4) }))
  .sort((a, b) => a.gi + a.gj - (b.gi + b.gj) || a.gi - b.gi)
  .map(({ gi, gj }) => {
    const i0 = gi * 5.4, j0 = gj * 5.4;
    const order = gi + (3 - gj) * 4; // fill the servers nearest the main server first
    return {
      i0, j0,
      rows: Array.from({ length: 8 }, (_, b) => ({
        d: `${(order * 0.14 + b * 0.05).toFixed(2)}s`,
        cubes: Array.from({ length: 8 }, (_, a) => {
          const [x, y] = pt(i0 + 0.3 + a * 0.5, j0 + 0.3 + b * 0.5, 0.4, FS);
          return { x: x.toFixed(1), y: y.toFixed(1), t: tints[(gi * 7 + gj * 3 + a * 5 + b * 3) % tints.length] };
        }),
      })),
    };
  });
const feeds = [0, 1, 2, 3].map((gi) => `M${xy(main.i + 2, main.j + 2, 3, FS)} L${xy(gi * 5.4, 3 * 5.4 + 4.4, 0.4, FS)}`);

const metrics = [
  { n: 6484, pre: "", unit: "sandboxes", label: "Running at the same time" },
  { n: 768, pre: "", unit: "AI agents", label: "Working at once. Every one finished." },
  { n: 8, pre: "≈", unit: "ms", label: "To start a fresh sandbox" },
  { n: 0, pre: "", unit: "failures", label: "From Spawnbox in 3,707 agent runs" },
];

const scale = [
  { v: "23", count: 23, unit: "agents", label: "On one 8 vCPU, 32 GB server" },
  { v: "26→37", unit: "servers", label: "Added by itself as the load grew" },
  { v: "≈400", unit: "ms", label: "Typical start for an agent, anywhere in the fleet" },
  { v: "2×", unit: "", label: "Double the servers, double the agents" },
];

const groups: { name: string; shape: string; items: [string, string, boolean?][] }[] = [
  {
    name: "Run code",
    shape: "cube",
    items: [
      ["Sandboxes", "Start, list, look at and delete sandboxes. Give each one a time limit, settings and labels."],
      ["Commands", "Run any command. Get the result at the end, or watch it live. Type input into it."],
      ["Files", "Read, write, list and delete files and folders."],
      ["Terminals", "Open a live terminal into the sandbox."],
      ["Git", "Download code from Git. Private repos work with a saved secret."],
      ["Services", "Keep a program, like a web server, running. It restarts when it stops or fails a health check, and keeps its recent output.", true],
    ],
  },
  {
    name: "Get ready",
    shape: "stack",
    items: [
      ["Templates", "Save a starting setup with your tools already installed. Start from Debian, a Docker image or devcontainer.json."],
      ["Spare sandboxes", "Keep spares ready and waiting. A new sandbox starts in about 8 ms. The number of spares grows and shrinks with use."],
      ["Build store", "Store templates in S3-compatible storage. Build each one only once. A sandbox can start before the whole template has downloaded."],
      ["Volumes", "Keep files after a sandbox ends. Share one read-only folder with many sandboxes."],
      ["Coding agent templates", "Claude Code, Codex and Copilot CLI templates come with Spawnbox. A new install builds them for you, so each agent sandbox starts in about 0.1 s.", true],
    ],
  },
  {
    name: "Save and copy",
    shape: "pair",
    items: [
      ["Pause and resume", "Pause a sandbox and save everything to disk. Wake it up in about 65 ms. Idle sandboxes pause by themselves."],
      ["Copy and save", "Make up to 16 copies of a running sandbox in under 1 s. Save it as a template without stopping it."],
      ["Persistent sandboxes", "Keep a sandbox until you delete it. If its VM is lost, the next call starts it again with the same ID, settings, volumes and ports. Primary only for now.", true],
    ],
  },
  {
    name: "Internet",
    shape: "gate",
    items: [
      ["Preview links", "Open a web app that runs in a sandbox from a link. The link can be public, need a token, or be private."],
      ["Browser sessions", "Share a short-lived link to one sandbox's terminal and web apps. No API key needed."],
      ["Site rules", "Choose which websites a sandbox can reach: all, some or none. Limit its speed. Log every connection."],
      ["Secrets", "Your API keys stay locked outside the sandbox. They are added to requests only for sites you allow."],
      ["Encrypted settings", "Sandbox and service settings are encrypted on disk and tied to one sandbox. A copied value can't be read anywhere else.", true],
    ],
  },
  {
    name: "Grow",
    shape: "row",
    items: [
      ["More servers", "Add servers when you need room. Each new sandbox goes to the server with the most space. Empty a server before you remove it."],
      ["Two backends", "Uses Firecracker on servers with KVM, and gVisor on servers without it. You can require Firecracker for a customer."],
      ["Many customers", "Serve many customers from one install. Each gets its own keys, limits, templates, secrets and site rules."],
      ["Failover", "Run two or more primaries on one Postgres database. If the leader stops, another takes over in about 15 s. Sandboxes on workers keep running.", true],
      ["Autoscaling", "When it's busy, Spawnbox asks your script or webhook for another server, and gives it back when idle. Use AWS, Terraform or any tool.", true],
      ["Memory guard", "When a server runs short of memory, the least recently used idle sandbox pauses to disk. Memory a sandbox frees goes back to the server.", true],
    ],
  },
  {
    name: "Watch and manage",
    shape: "slab",
    items: [
      ["Activity log", "A log of everything an agent does: commands, file changes, connections and key use. Watch it live or send it to OpenTelemetry."],
      ["Metrics", "Numbers for each server, ready for Prometheus: start times, errors, connections and free space."],
      ["Usage", "See how much CPU, memory, disk and network each customer and sandbox used, hour by hour."],
      ["CLI", "One spawnbox command does it all: sandboxes, files, templates, secrets, customers and logs."],
      ["Easy to run", "Install with one script. Runs as a normal system service with HTTPS. Comes back by itself after a crash."],
    ],
  },
];
let fid = 0;
const features = groups.flatMap((g) => g.items);
const newCount = features.filter(([, , isNew]) => isNew).length;

const site = Astro.site!.href;
const software = [
  {
    "@type": "SoftwareApplication",
    "@id": `${site}#software`,
    name: "Spawnbox",
    url: site,
    description:
      "Open-source sandbox server for AI agent platforms. Runs Firecracker microVMs on your own Linux servers, with a gVisor fallback.",
    applicationCategory: "DeveloperApplication",
    operatingSystem: "Linux",
    license: "https://www.apache.org/licenses/LICENSE-2.0",
    isAccessibleForFree: true,
    offers: { "@type": "Offer", price: 0, priceCurrency: "USD" },
    featureList: groups.flatMap((g) => g.items.map(([name]) => name)),
    downloadUrl: `${repo}/releases`,
    installUrl: `${site}install.sh`,
    sameAs: [repo],
  },
  {
    "@type": "SoftwareSourceCode",
    "@id": `${site}#source`,
    name: "spawnbox",
    codeRepository: repo,
    programmingLanguage: "Rust",
    license: "https://www.apache.org/licenses/LICENSE-2.0",
    targetProduct: { "@id": `${site}#software` },
  },
];

type Mark = "yes" | "part" | "no" | "unk";
const providers = ["Spawnbox", "E2B", "Daytona", "microsandbox", "CubeSandbox", "InstaVM"];
const compare: { row: string; cells: [Mark, string][] }[] = [
  {
    row: "Open source",
    cells: [
      ["yes", "Apache-2.0"],
      ["yes", "Apache-2.0"],
      ["no", "Repo archived Oct 2026; core moved private"],
      ["yes", "Apache-2.0"],
      ["yes", "Apache-2.0"],
      ["unk", "Not stated"],
    ],
  },
  {
    row: "Run it on your own server",
    cells: [
      ["yes", "One install script"],
      ["yes", "Docker Compose or Terraform"],
      ["no", "Open-source repo no longer maintained"],
      ["part", "Runs locally as a child process; beta"],
      ["yes", "KVM x86_64 host"],
      ["no", "Cloud service; local tool for development"],
    ],
  },
  {
    row: "How sandboxes are kept apart",
    cells: [
      ["yes", "Firecracker microVM"],
      ["yes", "Firecracker microVM"],
      ["unk", "Dedicated kernel; technology not named"],
      ["yes", "microVM"],
      ["yes", "KVM microVM (RustVMM)"],
      ["yes", "microVM"],
    ],
  },
  {
    row: "Works on servers without KVM",
    cells: [
      ["yes", "Uses gVisor instead"],
      ["no", "KVM required"],
      ["unk", "Not stated"],
      ["part", "Needs KVM, Apple Silicon or Windows WHP"],
      ["no", "KVM required"],
      ["unk", "Not stated"],
    ],
  },
  {
    row: "Many customers, each with own keys and limits",
    cells: [
      ["yes", "Own keys, limits, secrets, site rules"],
      ["part", "Auth and quotas"],
      ["part", "Organizations, API keys, limits"],
      ["unk", "Not stated"],
      ["part", "Per-sandbox traffic tokens"],
      ["part", "API keys, volume quotas"],
    ],
  },
  {
    row: "API keys stay outside the sandbox",
    cells: [
      ["yes", "Added outside the sandbox"],
      ["unk", "Not stated"],
      ["unk", "Not stated"],
      ["yes", "Never enter the VM"],
      ["yes", "Credential vault via egress proxy"],
      ["yes", "Injected via a proxy"],
    ],
  },
  {
    row: "Pause and resume",
    cells: [
      ["yes", "Pauses by itself, wakes in ≈65 ms"],
      ["yes", "Auto-pause"],
      ["part", "Snapshots"],
      ["yes", "Stop, start, snapshots"],
      ["yes", "Auto-pause and resume"],
      ["yes", "Pause, snapshot, resume"],
    ],
  },
  {
    row: "Copy a running sandbox",
    cells: [
      ["yes", "Up to 16 copies, < 1 s"],
      ["yes", "Up to 100 per request"],
      ["unk", "Not stated"],
      ["yes", "msb fork"],
      ["part", "Fork from a checkpoint"],
      ["part", "Clone a VM"],
    ],
  },
  {
    row: "Also sold as a hosted cloud",
    cells: [
      ["no", "None, by design"],
      ["yes", "E2B Cloud, BYOC"],
      ["yes", "Daytona cloud"],
      ["unk", "Not stated"],
      ["unk", "Not stated"],
      ["yes", "InstaVM cloud"],
    ],
  },
];
const sources = [
  ["E2B", "https://e2b.dev/open-source"],
  ["E2B runtime", "https://github.com/e2b-dev/infra"],
  ["Daytona", "https://github.com/daytonaio/daytona"],
  ["microsandbox", "https://github.com/superradcompany/microsandbox"],
  ["CubeSandbox", "https://github.com/TencentCloud/CubeSandbox"],
  ["InstaVM", "https://instavm.io"],
];
const markGlyph: Record<Mark, string> = { yes: "●", part: "◐", no: "○", unk: "?" };
const markLabel: Record<Mark, string> = { yes: "Yes", part: "Partly", no: "No", unk: "Not stated" };

const fits = [
  {
    tag: "YOUR AGENT",
    title: "Your agent asks for a sandbox.",
    sub: "One API call or one command. A fresh, empty computer is ready in about 8 ms.",
    rows: [
      ["From code", "POST /v1/sandboxes"],
      ["From a terminal", "spawnbox create"],
    ],
  },
  {
    tag: "THE SANDBOX",
    title: "Each agent gets its own small computer.",
    sub: "It is a tiny virtual machine. If the agent breaks something, only its own sandbox breaks.",
    rows: [
      ["Pause it", "spawnbox pause $S"],
      ["Show a web app", "spawnbox ports publish $S 3000"],
      ["Copy files in", "spawnbox cp ./src $S:/workspace/src"],
      ["Watch what it does", "spawnbox events --follow"],
    ],
  },
  {
    tag: "KEYS AND INTERNET",
    title: "Your API keys never go inside.",
    sub: "The agent sees a fake key. When it calls OpenAI, Spawnbox puts the real key in on the way out. Other sites get only the fake one.",
    rows: [
      ["The agent sees", "sbx_ph_... (a fake key)"],
      ["Allowed sites", "github.com, *.pypi.org"],
      ["Every other site", "blocked"],
    ],
  },
  {
    tag: "YOUR SERVER",
    title: "It all runs on your own server.",
    sub: "Install it with one script on a Linux machine. Nothing goes to our cloud.",
    rows: [
      ["Works best on", "Linux with KVM"],
      ["Also works on", "machines without KVM"],
      ["Need more room?", "add more servers"],
    ],
  },
];

const events = [
  ["sandbox.created", "sbx_c7mty9fysaf0t3d5"],
  ["exec.started", "python3 main.py"],
  ["net.dns", "pypi.org"],
  ["net.connection", "github.com:443"],
  ["secret.injected", "api.openai.com"],
  ["file.written", "/workspace/out.txt"],
  ["net.blocked", "example.org"],
  ["exec.finished", "exit 0"],
  ["sandbox.paused", "idle"],
];
---

<Page
  title="Spawnbox — self-hosted sandboxes for AI agents"
  description="Spawnbox is an open-source sandbox server for AI agent platforms. Firecracker microVMs on your own Linux servers, with a gVisor fallback."
  og="home"
  ogAlt="Spawnbox: sandboxes for AI agents, on your own servers. Firecracker microVMs with a gVisor fallback."
  schema={software}
>
      <section class="hero">
        <div class="hero-copy">
                    <h1 class="reveal">
            Sandboxes for AI agents,
            <span class="hl">on your own servers.</span>
          </h1>
          <p class="lede reveal">
            Spawnbox gives each AI agent its own small, safe computer to run code in. It is open source and runs
            on your own servers. A new one is ready in less than 100&nbsp;ms. Your API keys never go inside.
          </p>
          <div class="cta reveal">
            <button class="btn" type="button" id="install-toggle" aria-pressed="false" aria-controls="term"><span>Install on your server</span><span>Back to the demo</span></button>
            <a class="btn-line" href={repo}>Read the source</a>
          </div>
          <div class="typer reveal" id="term" data-mode="demo">
            <div class="face demo" aria-hidden="true">
              <span class="p">$</span> <span id="typed"></span><span class="caret"></span>
              {demoLines.map((l) => <template class="demo-line" data-len={l.length}><Code code={l} lang="bash" theme="github-light" inline /></template>)}
            </div>
            <div class="face inst" aria-hidden="true">
              <span class="p">$</span> <span id="inst-typed" data-cmd={install}></span>
              <template id="inst-tpl"><Code code={install} lang="bash" theme="github-light" inline /></template>
              <button class="copy" type="button" id="copy-install">Copy</button>
            </div>
          </div>
        </div>

        <figure class="scene hero-scene" aria-label="Drawing: an agent sends work to microVMs on one host">
          <svg viewBox="-200 -250 440 480" role="img">
            <defs>
              <pattern id="isogrid" width="41.57" height="24" patternUnits="userSpaceOnUse">
                <path d="M0 12 20.78 0 41.57 12 20.78 24z" fill="none" class="gridline"></path>
              </pattern>
            </defs>
            <rect x="-200" y="-250" width="440" height="480" fill="url(#isogrid)"></rect>

            <g class="drop" style="--d:0s">
              <Box i={0} j={0} w={10} d={7} h={0.6} s={S} tone="deep" />
            </g>
            {
              vms.map((v, n) => (
                <g class="drop" style={`--d:${0.15 + n * 0.12}s`}>
                  <g class={v.tone === "wire" ? "blinkbox" : "bob"} style={`--b:${n * 0.4}s`}>
                    <Box i={v.i} j={v.j} k={0.6} w={2} d={2} h={1.8} s={S} tone={v.tone} />
                    {v.logo && (
                      <Logo name={v.logo} size={22} x={at(v.i + 1, v.j + 1, 2.4)[0] - 11} y={at(v.i + 1, v.j + 1, 2.4)[1] - 11} />
                    )}
                  </g>
                </g>
              ))
            }

            {packets.map((p) => <path d={p.d} class="wire-path" />)}
            {
              packets.map((p) => (
                <circle r="3.5" class="packet">
                  <animateMotion dur="2.6s" begin={p.delay} repeatCount="indefinite" path={p.d} />
                </circle>
              ))
            }

            <g class="float">
              <Box i={-2} j={-2} k={6} w={1.4} d={1.4} h={1.4} s={S} tone="pale" />
            </g>

            <g>
              <path d={`M${xy(-1.3, -1.3, 7.6, S)} v-18 h-60`} class="leader"></path>
              <text x={at(-1.3, -1.3, 7.6)[0] - 64} y={at(-1.3, -1.3, 7.6)[1] - 14} class="lbl end">YOUR AGENT</text>
              <path d={`M${xy(9, 5, 1.2, S)} l30 30 h30`} class="leader"></path>
              <text x={at(9, 5, 1.2)[0] + 64} y={at(9, 5, 1.2)[1] + 34} class="lbl">SPARES</text>
              <text x={at(9, 5, 1.2)[0] + 64} y={at(9, 5, 1.2)[1] + 48} class="lbl mut">READY ≈ 8 ms</text>
              <path d={`M${xy(2, 2, 2.4, S)} l-40 -50 h-30`} class="leader"></path>
              <text x={at(2, 2, 2.4)[0] - 74} y={at(2, 2, 2.4)[1] - 46} class="lbl end">ONE SANDBOX</text>
              <path d={`M${xy(0, 7, 0.3, S)} v90`} class="leader"></path>
              <text x={at(0, 7, 0.3)[0]} y={at(0, 7, 0.3)[1] + 104} class="lbl">YOUR SERVER</text>
            </g>
          </svg>
          <figcaption class="status">
            <span><b class="live">●</b> RUNNING · sbx_c7mty9fysaf0t3d5</span>
            <span>UPTIME <span id="uptime">00:00:00</span></span>
          </figcaption>
        </figure>
      </section>

      <section class="metrics" aria-label="Measured timings">
        {
          metrics.map((m) => (
            <div class="metric reveal">
              <svg class="ruler" viewBox="0 0 100 10" preserveAspectRatio="none" aria-hidden="true">
                <path d="M0.5 0v10M99.5 0v10M0 5h100" />
              </svg>
              <p class="m-n">
                {m.pre}
                <span data-count={m.n}>{m.n.toLocaleString("en-US")}</span>
                <small>{m.unit}</small>
              </p>
              <p class="m-l">{m.label}</p>
            </div>
          ))
        }
        <p class="note">Measured on AWS, Nov 2026. <a href="#scale">How we tested ↓</a></p>
      </section>

      <section id="scale" class="scale">
        <header class="scale-head reveal">
          <p class="eyebrow">TESTED AT SCALE</p>
          <h2>768 coding agents at once.<br /><span class="hl">Every one finished.</span></h2>
          <p class="scale-sub">
            Each agent got its own 2 GiB microVM, ran Claude Code, wrote a file and pushed a commit. We doubled the count until it failed, then
            halved the gap. The fleet grew by itself from 26 to 37 machines.
          </p>
        </header>
        <div class="metrics scale-metrics">
          {
            scale.map((m) => (
              <div class="metric reveal">
                <svg class="ruler" viewBox="0 0 100 10" preserveAspectRatio="none" aria-hidden="true">
                  <path d="M0.5 0v10M99.5 0v10M0 5h100" />
                </svg>
                <p class="m-n">
                  {m.count != null ? <span data-count={m.count}>{m.v}</span> : m.v}
                  <small>{m.unit}</small>
                </p>
                <p class="m-l">{m.label}</p>
              </div>
            ))
          }
        </div>
        <p class="scale-note">
          Measured 10 Nov 2026 on AWS m8i.2xlarge workers. A typical agent sandbox started in about 400 ms through the fleet API. The agents talked
          to a stand-in model and a local git remote, so no AI or GitHub rate limits applied.
        </p>
      </section>

      <section id="fits">
        <header class="sec-head reveal">
          <span class="sec-no" aria-label="Section 1"><b>01</b><small>06</small></span>
          <h2>Every agent gets its own box.<br /><span class="hl">Scroll to see how it works.</span></h2>
        </header>
        <div class="fits">
          <div class="stack-wrap">
            <svg class="stack" viewBox="0 0 460 440" role="img" aria-label="Section drawing of one sandbox: your agent above, the microVM wall, the proxy in the wall, the host below">
              <defs>
                <pattern id="hatch" width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
                  <path d="M0 0 V7" class="hatch-line"></path>
                </pattern>
              </defs>
              <text x="12" y="20" class="lbl mut">HOW ONE SANDBOX WORKS</text>

              <g class="ly" data-l="0">
                <rect x="115" y="40" width="180" height="44" class="part"></rect>
                <text x="205" y="60" class="lbl mid">YOUR AI AGENT</text>
                <text x="205" y="75" class="lbl mid mut">asks for a sandbox</text>
                <path d="M205 84 V120" class="draw flow" pathLength="1"></path>
                <path d="M199 112 L205 120 L211 112" class="arrow"></path>
                <text x="215" y="106" class="lbl small">start one</text>
              </g>

              <g class="ly" data-l="1">
                <path d="M80 120 H330 V330 H80 Z M96 136 V314 H314 V136 Z" class="wall" fill-rule="evenodd"></path>
