      <section id="install">
        <header class="sec-head reveal">
          <span class="sec-no" aria-label="Section 6"><b>06</b><small>06</small></span>
          <h2>Install</h2>
          <p class="sec-sub">You need a Linux server: Ubuntu 22.04+ or Debian 12+, x86_64. KVM is best, but not required.</p>
        </header>
          <ol class="steps reveal">
            <li><b>Get a server.</b> At least 4 GiB memory and 40 GiB disk. A physical server, or a cloud VM that can run VMs inside it.</li>
            <li><b>Run the install script.</b> <a href="#term" id="show-install">Get the command at the top</a>. It downloads Spawnbox, checks the download is not changed, and starts it as a service.</li>
            <li><b>Start a sandbox.</b> Use the <code>spawnbox</code> command or the HTTP API.</li>
          </ol>
        <p class="warn reveal">
          <b>WARNING</b> Sandboxes run code you do not trust. Use a separate server, not your own laptop or a live
          production server.
        </p>
      </section>

    <script>
      const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;

      function countUp(el: HTMLElement) {
        const end = Number(el.dataset.count);
        const t0 = performance.now();
        const tick = (t: number) => {
          const k = Math.min(1, (t - t0) / 900);
          el.textContent = Math.round(end * (1 - Math.pow(1 - k, 3))).toLocaleString("en-US");
          if (k < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      }

      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            e.target.classList.add("in");
            if (!reduce) e.target.querySelectorAll<HTMLElement>("[data-count]").forEach(countUp);
            io.unobserve(e.target);
          }
        },
        { threshold: 0.15 },
      );
      document.querySelectorAll<HTMLElement>(".reveal").forEach((el, n) => {
        el.style.setProperty("--rd", `${(n % 4) * 70}ms`);
        io.observe(el);
      });


      const marks = document.querySelectorAll<SVGElement>(".stack [data-l]");
      const stepIo = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            const n = (e.target as HTMLElement).dataset.step!;
            document.querySelectorAll(".fit-step").forEach((s) => s.classList.toggle("on", s === e.target));
            marks.forEach((m) => m.classList.toggle("on", m.dataset.l!.split(" ").includes(n)));
          }
        },
        { rootMargin: "-45% 0px -45% 0px" },
      );
      document.querySelectorAll(".fit-step").forEach((el) => stepIo.observe(el));

      const up = document.getElementById("uptime")!;
      const t0 = Date.now();
      const pad = (n: number) => String(n).padStart(2, "0");
      const clock = () => {
        const s = Math.floor((Date.now() - t0) / 1000);
        up.textContent = `${pad(Math.floor(s / 3600))}:${pad(Math.floor(s / 60) % 60)}:${pad(s % 60)}`;
      };
      if (!reduce) setInterval(clock, 1000);

      // show the first n characters of pre-highlighted code, keeping its colors
      const typeCode = (el: HTMLElement, tpl: HTMLTemplateElement, n: number) => {
        el.replaceChildren(tpl.content.cloneNode(true));
        const walk = document.createTreeWalker(el, NodeFilter.SHOW_TEXT);
        let left = n;
        for (let t = walk.nextNode() as Text | null; t; t = walk.nextNode() as Text | null) {
          if (left >= t.length) left -= t.length;
          else {
            t.data = t.data.slice(0, left);
            left = 0;
          }
        }
      };

      const pty = document.getElementById("pty-typed")!;
      const ptyTpl = document.getElementById("pty-tpl") as HTMLTemplateElement;
      const cmdLen = ptyTpl.content.textContent!.length;
      if (reduce) typeCode(pty, ptyTpl, cmdLen);
      else {
        let pi = 0;
        const ptyStep = () => {
          pi = (pi + 1) % (cmdLen + 25);
          typeCode(pty, ptyTpl, pi);
          setTimeout(ptyStep, 90);
        };
        ptyStep();
      }

      const lines = [...document.querySelectorAll<HTMLTemplateElement>(".demo-line")];
      const fleetN = document.getElementById("fleet-n")!;
      const fleetS = document.getElementById("fleet-s")!;
      const fleetRows = [...document.querySelectorAll<SVGGElement>(".fr")];
      // count what is on screen, so the number always matches the drawing
      const countFleet = () => {
        const on = fleetRows.flatMap((r, n) => (+getComputedStyle(r).opacity > 0.5 ? [n] : []));
        fleetN.textContent = (on.length * 8).toLocaleString("en-US");
        fleetS.textContent = String(new Set(on.map((n) => n >> 3)).size);
      };
      countFleet();
      if (!reduce) setInterval(countFleet, 80);
      const term = document.getElementById("term")!;
      const toggle = document.getElementById("install-toggle")!;
      const instTyped = document.getElementById("inst-typed")!;
      const copyBtn = document.getElementById("copy-install")!;
      const installCmd = instTyped.dataset.cmd!;
      const instTpl = document.getElementById("inst-tpl") as HTMLTemplateElement;
      const [demoFace, instFace] = term.querySelectorAll(".face");
      let instTimer = 0;
      toggle.addEventListener("click", () => {
        const on = term.dataset.mode !== "install";
        term.dataset.mode = on ? "install" : "demo";
        toggle.setAttribute("aria-pressed", String(on));
        demoFace.setAttribute("aria-hidden", String(on));
        instFace.setAttribute("aria-hidden", String(!on));
        clearTimeout(instTimer);
        if (!on) return;
        if (reduce) {
          typeCode(instTyped, instTpl, installCmd.length);
          return;
        }
        let i = 0;
        const type = () => {
          typeCode(instTyped, instTpl, ++i);
          if (i < installCmd.length) instTimer = window.setTimeout(type, 18);
        };
        instTimer = window.setTimeout(type, 250);
      });
      copyBtn.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(installCmd);
          copyBtn.textContent = "Copied ✓";
        } catch {
          copyBtn.textContent = "Press ⌘C";
          getSelection()?.selectAllChildren(instTyped);
        }
        setTimeout(() => (copyBtn.textContent = "Copy"), 1600);
      });
      document.getElementById("show-install")!.addEventListener("click", (e) => {
        e.preventDefault();
        term.scrollIntoView({ behavior: reduce ? "auto" : "smooth", block: "center" });
        if (term.dataset.mode !== "install") toggle.click();
      });
      const typed = document.getElementById("typed")!;
      if (reduce) {
        typeCode(typed, lines[0], +lines[0].dataset.len!);
        document.querySelectorAll("svg").forEach((s) => s.pauseAnimations());
      } else {
        let li = 0;
        let ci = 0;
        let del = false;
        const step = () => {
          const line = lines[li];
          const len = +line.dataset.len!;
          ci += del ? -1 : 1;
          typeCode(typed, line, ci);
          let wait = del ? 25 : 55;
          if (!del && ci === len) {
            del = true;
            wait = 1600;
          } else if (del && ci === 0) {
            del = false;
            li = (li + 1) % lines.length;
            wait = 300;
          }
          setTimeout(step, wait);
        };
        step();
      }
    </script>
