+
+// Local only: HIGHLIGHT_PROVIDER=Spawnbox marks that provider's row.
+const HIGHLIGHT = process.env.HIGHLIGHT_PROVIDER;
+const HIGHLIGHT_STYLE = HIGHLIGHT
+	? `.row.hl { background: #fff1e6; box-shadow: 0 0 0 8px #fff1e6, 0 0 0 10px #f97316; border-radius: 4px; }
+.row.hl .provider-title { color: #c2410c; font-weight: 700; }
+.row.hl .fill { background: #f97316 !important; }
+.row.hl .total { color: #c2410c; }
+`
+	: "";
+function highlightRows(rows: readonly string[]): readonly string[] {
+	if (!HIGHLIGHT) return rows;
+	const marker = `<span class="provider-title">${escapeHtml(HIGHLIGHT)}</span>`;
+	return rows.map((r) => (r.includes(marker) ? r.replace('<div class="row', '<div class="row hl') : r));
+}
